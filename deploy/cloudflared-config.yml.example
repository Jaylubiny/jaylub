# Copy to /etc/cloudflared/config.yml and replace both tunnel placeholders.
tunnel: REPLACE_WITH_TUNNEL_UUID
credentials-file: /etc/cloudflared/REPLACE_WITH_TUNNEL_UUID.json

ingress:
  - hostname: jaylub.com
    service: http://127.0.0.1:8080
  - hostname: www.jaylub.com
    service: http://127.0.0.1:8080
  - hostname: company.jaylub.com
    service: http://127.0.0.1:8090
  - hostname: email.jaylub.com
    service: http://127.0.0.1:9010
  - hostname: music.jaylub.com
    service: http://127.0.0.1:9000
  - service: http_status:404
