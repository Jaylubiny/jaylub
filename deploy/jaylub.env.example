# Required by the application because it starts the Discord bot.
DISCORD_BOT_TOKEN=

# Required for Resend outbound and inbound email processing.
RESEND_API_KEY=
WEBHOOK_SECRET=

# Used to issue secure shared cookies across jaylub.com subdomains.
MY_DOMAIN=jaylub.com
SESSION_COOKIE_DOMAIN=.jaylub.com

# Optional Discord OAuth integration settings.
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=
BOT_TOKEN=
GUILD_ID=
WEBHOOK_URL=
